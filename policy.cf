body when file_deleted(file)
{
  file_deleted => "$(file)";
}

body when file_created(file)
{
  file_created => "$(file)";
}

body when file_modified(file)
{
  file_modified => "$(file)";
}

body when file_content_modified(file)
{
  file_content_modified => "$(file)";
}

body when file_permissions_changed(file)
{
  file_permissions_changed => "$(file)";
}

body when file_owner_changed(file)
{
  file_owner_changed => "$(file)";
}

body when file_size_exceeds(file, size)
{
  file_size_exceeds => "$(file)";
  size_threshold => "$(size)";
}

body when user_added(user)
{
  user_added => "$(user)";
}

body when user_removed(user)
{
  user_removed => "$(user)";
}

body when package_installed(package)
{
  package_installed => "$(package)";
  package_module => "apt_get";
}

body when package_uninstalled(package)
{
  package_uninstalled => "$(package)";
  package_module => "apt_get";
}

# $(sys.workdir)/modules/packages/apt_get of the masterfiles, its shebang is
# /usr/bin/python, which Ubuntu 24 doesn't have
body package_module apt_get
{
  interpreter => "/usr/bin/python3";
}

bundle reactor record_event(file)
{
  reports:
   "handled '$(file)'";
}

bundle reactor main
{
  vars:
    "input" data => readjson("$(this.promise_dirname)/input.json", 99999999);
    "event" string => "$(input[event])";
    "size_threshold" string => "$(input[size_threshold])";
    "files" slist => getvalues("input[files]");

  classes:
    "$(event)" expression => "any";

  events:
    file_deleted::
      "$(files)"
        when => file_deleted("$(files)"),
        then => record_event("$(files)");

    file_created::
      "$(files)"
        when => file_created("$(files)"),
        then => record_event("$(files)");

    file_modified::
      "$(files)"
        when => file_modified("$(files)"),
        then => record_event("$(files)");

    file_content_modified::
      "$(files)"
        when => file_content_modified("$(files)"),
        then => record_event("$(files)");

    file_permissions_changed::
      "$(files)"
        when => file_permissions_changed("$(files)"),
        then => record_event("$(files)");

    file_owner_changed::
      "$(files)"
        when => file_owner_changed("$(files)"),
        then => record_event("$(files)");

    file_size_exceeds::
      "$(files)"
        when => file_size_exceeds("$(files)", "$(size_threshold)"),
        then => record_event("$(files)");

    user_added::
      "$(files)"
        when => user_added("$(files)"),
        then => record_event("$(files)");

    user_removed::
      "$(files)"
        when => user_removed("$(files)"),
        then => record_event("$(files)");

    package_installed::
      "$(files)"
        when => package_installed("$(files)"),
        then => record_event("$(files)");

    package_uninstalled::
      "$(files)"
        when => package_uninstalled("$(files)"),
        then => record_event("$(files)");
}
